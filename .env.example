# =============================================================================
# Almarah Foundation Fundraising Platform — advanced configuration
#
# YOU DO NOT NEED THIS FILE. For normal hosting, put your database name, user
# and password in config.php and open /setup — see START-HERE.txt.
#
# This file exists for advanced setups (staging/production split, container
# environment variables, or hosting panels that inject configuration). Values
# here are LOWER priority than config.php and than real environment variables.
# The site works with none of this present.
# =============================================================================

APP_NAME="Almarah Foundation"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://fundraise.almarah.org
APP_TIMEZONE=UTC
APP_CURRENCY=PKR
APP_KEY=

# --- database ---------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=almarah_platform
DB_USERNAME=almarah
DB_PASSWORD=
DB_CHARSET=utf8mb4

# --- sessions / security ----------------------------------------------------
SESSION_NAME=almarah_session
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAMESITE=Lax
CSRF_KEY=

LOGIN_MAX_ATTEMPTS=5
LOGIN_DECAY_MINUTES=15
TRUSTED_PROXIES=

# --- mail (SMTP only — mail() is never used) --------------------------------
MAIL_MAILER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=fundraise@almarah.org
MAIL_FROM_NAME="Almarah Foundation"
MAIL_REPLY_TO=info@almarah.org
MAIL_QUEUE_ENABLED=true
MAIL_MAX_RETRIES=3
MAIL_VERIFY_PEER=true
MAIL_DEBUG=false

# --- payments: Meezan Bank (hosted, register.do / getOrderStatus.do) --------
MEEZAN_ENABLED=true
MEEZAN_ENVIRONMENT=sandbox
MEEZAN_SANDBOX_URL=https://sandbox.meezanbank.com/payment
MEEZAN_LIVE_URL=https://payment.meezanbank.com/payment
MEEZAN_USERNAME=
MEEZAN_PASSWORD=
MEEZAN_CURRENCY_CODE=586
MEEZAN_CURRENCY_NAME=PKR
MEEZAN_TIMEOUT=30
MEEZAN_MERCHANT_ID=

# --- payments: Etisalat / UBL EPG REST (Registration + Finalization) --------
ETISALAT_ENABLED=true
ETISALAT_ENVIRONMENT=sandbox
ETISALAT_SANDBOX_URL=https://demo-ipg.ctdev.comtrust.ae:2443/epg/rest
ETISALAT_LIVE_URL=https://ipg.comtrust.ae:2443/epg/rest
ETISALAT_CUSTOMER=
ETISALAT_USERNAME=
ETISALAT_PASSWORD=
ETISALAT_STORE=
ETISALAT_TERMINAL=
ETISALAT_CURRENCY=PKR
ETISALAT_TIMEOUT=30
# Payment-page domains returned by the EPG (separate from the REST API URL).
ETISALAT_ALLOWED_HOSTS=ipg.comtrust.ae,demo-ipg.ctdev.comtrust.ae,demoipg.comtrust.ae

# --- donations --------------------------------------------------------------
DONATION_MIN_MINOR=10000
DONATION_MAX_MINOR=500000000
CALLBACK_STATE_TTL_MINUTES=180
PAYMENT_LOCK_TIMEOUT_SECONDS=45

# --- web root ---------------------------------------------------------------
# Leave EMPTY in the normal single-folder layout: the application folder is the
# folder the web server serves. Set it to an absolute path only when the host
# serves the site from somewhere else.
PUBLIC_PATH=

# --- uploads ----------------------------------------------------------------
UPLOAD_MAX_BYTES=4194304
UPLOAD_ALLOWED_MIME=jpeg,jpg,png,webp
UPLOAD_ALLOWED_EXT=jpg,jpeg,png,webp

# --- installer ---------------------------------------------------------------
# Empty: the /setup page asks for no key at all. Set a word and the same word
# must be typed on the setup form (see START-HERE.txt).
SETUP_LOCK=

# --- feature switches -------------------------------------------------------
FUNDRAISER_AUTO_APPROVE=false
TEAM_FUNDRAISING_ENABLED=true
MAINTENANCE_MODE=false
