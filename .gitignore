/.env
/vendor/
/storage/logs/*
!/storage/logs/.gitkeep
/storage/cache/*
!/storage/cache/.gitkeep
/storage/app/*
!/storage/app/.gitkeep
/uploads/*
!/uploads/.gitkeep
# The protection file must survive a commit: '/uploads/*' above swallows every
# dotfile in that folder, which is how uploads/.htaccess came to be missing
# from the packaged site even though both install guides describe it.
!/uploads/.htaccess
.phpunit.result.cache
.phpunit.cache/
*.sqlite
.DS_Store

# Server error logs must never be committed (v15) - they reveal server paths.
/error_log
/php_errorlog
*.log
